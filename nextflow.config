// For those of you who wish not to download the data, make sure you --in it.
params {
    accession = "M21012"
    in = "$projectDir/data"
}

process {
    withName: TRIMAL {
        publishDir = [
            path: { "results" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // run as my user, so files in work/ are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}


